# --- CONFIGURATION GÉNÉRALE ---
PORT=3000
NODE_ENV=production
FRONTEND_URL="https://ton-site.vercel.app"

# --- BASE DE DONNÉES NEON ---
# Remplacer par l'URL poolée de Neon
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Remplacer par l'URL non-poolée de Neon (pour les migrations)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- SÉCURITÉ ---
JWT_SECRET="votre_secret_jwt_tres_long_et_securise"

# --- CLOUDINARY ---
CLOUDINARY_CLOUD_NAME="votre_cloud_name"
CLOUDINARY_API_KEY="votre_api_key"
CLOUDINARY_API_SECRET="votre_api_secret"
